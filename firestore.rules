rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // MOMENTS COLLECTION - #ConstantiaMoment Feed
    // =========================
    match /moments/{momentId} {
      // Anyone can read moments (public feed)
      allow read: if true;
      
      // Anyone can create moments (no authentication required)
      allow create: if true;
      
      // Users can only update likes and comments count
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']);
      
      // No deletion allowed
      allow delete: if false;
    }

    // =========================
    // COMMENTS COLLECTION
    // =========================
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      
      // Anyone can create comments
      allow create: if true;
      
      // Users can only update likes
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      
      // No deletion allowed
      allow delete: if false;
    }

    // =========================
    // 20% PROMOTION FOR FIRST REGISTRATION
    // =========================
    match /promotions/{promotionId} {
      // Read promotions
      allow read: if true;
      
      // Track used promotions to prevent abuse
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.promoCode == 'WELCOME20'
        && request.resource.data.used == false
        && request.resource.data.usedAt == null;
      
      // Mark promotion as used (only once per user)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt']);
    }
    
    // =========================
    // DEVICE TRACKING FOR PROMOTION ABUSE PREVENTION
    // =========================
    match /devicePromotions/{deviceId} {
      // Track which devices have used the promotion
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'owner'];
      allow create: if true;  // Allow creation for checking if device already exists
      allow write: if false;   // Prevent modification of existing records
    }

    // =========================
    // ORDERS COLLECTION
    // =========================
    match /orders/{orderId} {
      // Customers can create orders only for themselves
      allow create: if request.auth != null
        && request.auth.token.role == 'customer'
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.totalPrice > 0;

      // Customers can update only items or instructions, not status or price
      allow update: if request.auth != null
        && request.auth.token.role == 'customer'
        && request.auth.uid == resource.data.customerId
        && request.resource.data.keys().hasOnly(['items', 'specialInstructions'])
        && request.resource.data.totalPrice == resource.data.totalPrice
        && request.resource.data.status == resource.data.status;

      // Staff can move status forward: pending → preparing → ready
      allow update: if request.auth != null
        && request.auth.token.role == 'staff'
        && request.resource.data.keys().hasOnly(['status'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'preparing') ||
          (resource.data.status == 'preparing' && request.resource.data.status == 'ready')
        );

      // Delivery can only move ready → delivered
      allow update: if request.auth != null
        && request.auth.token.role == 'delivery'
        && request.auth.uid == resource.data.deliveryId
        && request.resource.data.keys().hasOnly(['status'])
        && resource.data.status == 'ready'
        && request.resource.data.status == 'delivered';

      // Admin can update any field except customerId, but must respect status transitions
      allow update: if request.auth != null
        && request.auth.token.role == 'admin'
        && request.resource.data.customerId == resource.data.customerId
        && (
          (resource.data.status == 'pending' && request.resource.data.status in ['pending','preparing']) ||
          (resource.data.status == 'preparing' && request.resource.data.status in ['preparing','ready']) ||
          (resource.data.status == 'ready' && request.resource.data.status in ['ready','delivered']) ||
          (resource.data.status == 'delivered' && request.resource.data.status == 'delivered')
        );

      // Owner has full write access
      allow write: if request.auth != null && request.auth.token.role == 'owner';

      // Read rules
      allow read: if request.auth != null && (
        request.auth.token.role in ['customer','staff','delivery','admin','owner']
      );
    }
    
    // =========================
    // USERS COLLECTION
    // =========================
    match /users/{userId} {
      // Users can read any user profile (for displaying author names)
      allow read: if true;
      
      // Users can only write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Track if user has used the 20% promotion
      allow update: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedPromotion', 'promotionUsedAt']);
    }
  }
}
