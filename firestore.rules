rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // USERS COLLECTION - Allow users to update their own profile
    // ========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // ========================================
    // MOMENTS COLLECTION
    // ========================================
    match /moments/{momentId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']);
      allow delete: if false;
    }
    
    // ========================================
    // COMMENTS COLLECTION
    // ========================================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if false;
    }
    
    // ========================================
    // ORDERS COLLECTION
    // ========================================
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    
    // ========================================
    // PROMOS COLLECTION
    // ========================================
    match /promos/{promoId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    
    // ========================================
    // CATALOG - Allow all other reads
    // ========================================
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
