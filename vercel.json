{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "NEXT_IGNORE_ESLINT": "true",
      "NEXT_DISABLE_ESLINT": "true",
      "NEXT_IGNORE_TYPECHECK": "true"
    }
  },
  "alias": ["gardengrains.co.za", "gardengrains.vercel.app"]
}
