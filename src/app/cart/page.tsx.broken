"use client";

export const dynamic = "force-dynamic";

import React, { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import Image from "next/image";
import { useCart } from "@/contexts/CartContext";
import { CartItem } from "@/types";
import { useAuth } from "@/context/AuthContext";
import { 
  FiShoppingCart, 
  FiArrowLeft, 
  FiPackage, 
  FiLock, 
  FiAlertCircle,
  FiPlus,
  FiMinus,
  FiTrash2,
  FiTruck,
  FiShield,
  FiStar,
  FiCheck,
  FiCoffee,
  FiDroplet,
  FiShoppingBag,
  FiEdit2,
  FiDollarSign
} from "react-icons/fi";

interface DeliveryInfo {
  distance: number;
  deliveryFee: number;
  freeDelivery: boolean;
}

// Helper to format prices
const formatPrice = (price: number) => {
  return `R${price.toFixed(2)}`;
};

export default function CartPage() {
  const router = useRouter();
  const {
    cart: cartItems,
    updateQuantity,
    removeFromCart,
    clearCart,
    getCartTotal,
    getDeliveryFee
  } = useCart();
  
  // Calculate derived values
  const totalItems = (cartItems || []).reduce((total, item) => total + (item.quantity || 1), 0);
  const totalPrice = getCartTotal();
  
  // Helper functions (if needed by the component)
  const getItemTotal = (item: CartItem): number => {
    const basePrice = item.price || 0;
    const addOnsTotal = (item.addOns || []).reduce((sum: number, addon: { price?: number }) => sum + (addon.price || 0), 0);
    const addonsTotal = ((item.addOns || item.addOns || []).reduce((sum: number, addon: { price?: number }) => sum + (addon.price || 0), 0);
    const friesTotal = item.fries?.price || (item.friesUpsell as any)?.price || 0;
    const juiceTotal = item.juice?.price || (item.juiceUpsell as any)?.price || 0;
    return (basePrice + addOnsTotal + addonsTotal + friesTotal + juiceTotal) * (item.quantity || 1);
  };
  
  const getNormalizedItems = () => cartItems || [];
  
  const getItemPriceBreakdown = (item: CartItem): { basePrice: number; addOnsTotal: number; friesTotal: number; juiceTotal: number; itemTotal: number } => {
    const basePrice = item.price || 0;
    const addOnsTotal = (item.addOns || []).reduce((sum: number, addon: { price?: number }) => sum + (addon.price || 0), 0);
    const addonsTotal = (item.addOns || item.addOns || []).reduce((sum: number, addon: { price?: number }) => sum + (addon.price || 0), 0);
    const friesTotal = item.fries?.price || item.friesUpsell || item.fries?.price || 0;
    const juiceTotal = item.juice?.price || item.juiceUpsell || item.juice?.price || 0;
    const itemTotal = (basePrice + addOnsTotal + addonsTotal + friesTotal + juiceTotal) * (item.quantity || 1);
    
    return {
      basePrice,
      addOnsTotal: addOnsTotal + addonsTotal,
      friesTotal,
      juiceTotal,
      itemTotal
    };
  };;
  const { user, loading: authLoading } = useAuth();
  const [pastOrders, setPastOrders] = useState(0);
  const [deliveryInfo, setDeliveryInfo] = useState<DeliveryInfo>({
    distance: 5,
    deliveryFee: 30,
    freeDelivery: false
  });
  const [isClient, setIsClient] = useState(false);
  const [showAuthPrompt, setShowAuthPrompt] = useState(false);
  const [editingItem, setEditingItem] = useState<string | null>(null);

  // Get normalized items for display
  const normalizedItems = getNormalizedItems();

  // Set client-side flag
  useEffect(() => {
    setIsClient(true);
  }, []);

  // Calculate delivery fee and free delivery threshold
  useEffect(() => {
    const freeDeliveryThreshold = 850;
    if (totalPrice >= freeDeliveryThreshold) {
      setDeliveryInfo(prev => ({
        ...prev,
        deliveryFee: 0,
        freeDelivery: true
      }));
    } else {
      setDeliveryInfo(prev => ({
        ...prev,
        deliveryFee: 30,
        freeDelivery: false
      }));
    }
  }, [totalPrice]);

  // Mock past orders for demonstration
  useEffect(() => {
    if (user) {
      // In a real app, fetch from Firestore
      setPastOrders(3); // Mock data
    }
  }, [user]);

  const handleCheckout = () => {
    if (!user) {
      // Show authentication prompt
      setShowAuthPrompt(true);
      return;
    }
    
    // Proceed to checkout for authenticated users
    router.push("/checkout");
  };

  const handleQuantityChange = (id: string, change: number) => {
    const item = cartItems.find(item => item.id === id);
    if (item) {
      const newQuantity = item.quantity + change;
      if (newQuantity >= 1) {
        updateQuantity(id, newQuantity);
      }
    }
  };

  const handleRemoveItem = (id: string) => {
    removeFromCart(id);
  };

  if (!isClient || authLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50">
        <div className="flex flex-col items-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mb-4"></div>
          <div className="text-lg text-gray-600">Loading your cart...</div>
        </div>
      </div>
    );
  }

  if (cartItems.length === 0) {
    return (
      <div className="min-h-screen bg-gray-50">
        <div className="container mx-auto px-4 py-16">
          <div className="max-w-md mx-auto text-center">
            <div className="w-32 h-32 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-8">
              <FiShoppingCart className="w-16 h-16 text-gray-400" />
            </div>
            <h1 className="text-3xl font-bold text-gray-900 mb-4">Your cart is empty</h1>
            <p className="text-gray-600 mb-8 text-lg">
              Add some delicious, healthy items from our menu to get started!
            </p>
            <Link
              href="/menu"
              className="inline-flex items-center px-8 py-4 bg-blue-600 text-white text-lg font-semibold rounded-lg hover:bg-blue-700 transition duration-300 shadow-lg"
            >
              <FiArrowLeft className="mr-3" />
              Browse Our Menu
            </Link>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Authentication Prompt Modal */}
      {showAuthPrompt && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
            <div className="flex items-center mb-4">
              <FiAlertCircle className="w-8 h-8 text-yellow-500 mr-3" />
              <h3 className="text-xl font-bold">Sign In Required</h3>
            </div>
            
            <p className="text-gray-600 mb-6">
              To complete your purchase and enjoy a seamless shopping experience, please create an account or sign in.
            </p>
            
            <div className="space-y-3">
              <button
                onClick={() => router.push("/auth/signup?returnUrl=/checkout")}
                className="w-full py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition"
              >
                Create Account & Checkout
              </button>
              
              <button
                onClick={() => router.push("/auth/signin?returnUrl=/checkout")}
                className="w-full py-3 border border-blue-600 text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition"
              >
                Sign In to Checkout
              </button>
              
              <button
                onClick={() => setShowAuthPrompt(false)}
                className="w-full py-3 text-gray-600 hover:text-gray-800"
              >
                Continue as Guest
              </button>
            </div>
            
            <div className="mt-6 p-4 bg-blue-50 rounded-lg">
              <p className="text-sm text-blue-800 font-medium mb-2">
                Benefits of creating an account:
              </p>
              <ul className="text-sm text-blue-700 space-y-1">
                <li className="flex items-center">
                  <FiStar className="w-4 h-4 mr-2" />
                  Fast checkout on future orders
                </li>
                <li className="flex items-center">
                  <FiPackage className="w-4 h-4 mr-2" />
                  Track your order history
                </li>
                <li className="flex items-center">
                  <FiTruck className="w-4 h-4 mr-2" />
                  Save your delivery addresses
                </li>
                <li className="flex items-center">
                  <FiShield className="w-4 h-4 mr-2" />
                  Exclusive member discounts
                </li>
              </ul>
            </div>
          </div>
        </div>
      )}

      <div className="container mx-auto px-4 py-8">
        {/* Header */}
        <div className="mb-8">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-3xl font-bold flex items-center text-gray-900">
                <FiShoppingCart className="mr-3" />
                Your Shopping Cart
              </h1>
              <p className="text-gray-600 mt-2">
                Review your items and proceed to checkout
              </p>
            </div>
            
            <div className="flex items-center space-x-4">
              {user && pastOrders > 0 && (
                <div className="inline-flex items-center px-4 py-2 bg-green-100 text-green-800 rounded-full">
                  <FiPackage className="mr-2" />
                  <span className="font-medium">{pastOrders} past order{pastOrders !== 1 ? "s" : ""}</span>
                </div>
              )}
              
              {!user && (
                <div className="inline-flex items-center px-4 py-2 bg-yellow-100 text-yellow-800 rounded-full">
                  <FiLock className="mr-2" />
                  <span className="font-medium">Guest checkout</span>
                </div>
              )}
            </div>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {/* Cart Items - Detailed Summary */}
          <div className="lg:col-span-2">
            <div className="bg-white rounded-xl shadow-lg overflow-hidden">
              <div className="p-6 border-b">
                <h2 className="text-xl font-bold text-gray-900">Order Details</h2>
                <p className="text-gray-600 mt-1">
                  {totalItems} item{totalItems !== 1 ? "s" : ""} in your cart • Verify your order below
                </p>
              </div>
              
              <div className="divide-y">
                {cartItems.map((cartItem, index) => {
                  const normalizedItem = normalizedItems[index];
                  const itemTotal = getItemTotal(cartItem);
                  const priceBreakdown = getItemPriceBreakdown(cartItem);
                  
                  return (
                    <div key={cartItem.id} className="p-6">
                      <div className="flex flex-col md:flex-row">
                        {/* Product Image */}
                        <div className="w-full md:w-32 h-32 bg-gray-100 rounded-lg overflow-hidden flex-shrink-0 mb-4 md:mb-0">
                          {cartItem.image ? (
                            <Image
                              src={cartItem.image}
                              alt={cartItem.name}
                              width={128}
                              height={128}
                              className="w-full h-full object-cover"
                            />
                          ) : (
                            <div className="w-full h-full flex items-center justify-center text-gray-400">
                              <FiShoppingBag className="w-12 h-12" />
                            </div>
                          )}
                        </div>
                        
                        {/* Product Details */}
                        <div className="md:ml-6 flex-grow">
                          <div className="flex flex-col md:flex-row md:items-start justify-between">
                            <div className="mb-4 md:mb-0 flex-grow">
                              <div className="flex items-start justify-between">
                                <div>
                                  <h3 className="font-bold text-lg text-gray-900">{cartItem.name}</h3>
                                  <p className="text-gray-600 mt-1">
                                    <span className="font-semibold">{formatPrice(cartItem.price)}</span> base price each
                                  </p>
                                </div>
                                <button
                                  onClick={() => setEditingItem(editingItem === cartItem.id ? null : cartItem.id)}
                                  className="md:hidden text-blue-600 hover:text-blue-800"
                                >
                                  <FiEdit2 className="w-5 h-5" />
                                </button>
                              </div>
                              
                              {/* Display all customizations WITH PRICES */}
                              {normalizedItem.addons && normalizedItem.addons.length > 0 && (
                                <div className="mt-3">
                                  <p className="text-sm font-medium text-gray-700 mb-1">Add-ons:</p>
                                  <div className="space-y-1">
                                    {normalizedItem.addons.map((addon, idx) => (
                                      <div key={idx} className="flex items-center justify-between">
                                        <span className="px-2 py-1 bg-blue-50 text-blue-700 text-xs rounded flex items-center">
                                          <FiPlus className="w-3 h-3 mr-1" />
                                          {addon.name}
                                        </span>
                                        <span className="text-xs font-medium text-blue-700">
                                          +{formatPrice(addon.price || 0)} each
                                        </span>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              )}
                              
                              {normalizedItem.dressings && normalizedItem.dressings.length > 0 && (
                                <div className="mt-3">
                                  <p className="text-sm font-medium text-gray-700 mb-1">Dressings:</p>
                                  <div className="flex flex-wrap gap-1">
                                    {normalizedItem.dressings.map((dressing, idx) => (
                                      <span key={idx} className="px-2 py-1 bg-green-50 text-green-700 text-xs rounded flex items-center">
                                        <FiDroplet className="w-3 h-3 mr-1" />
                                        {dressing} (included)
                                      </span>
                                    ))}
                                  </div>
                                </div>
                              )}
                              
                              {normalizedItem.bases && normalizedItem.bases.length > 0 && (
                                <div className="mt-3">
                                  <p className="text-sm font-medium text-gray-700 mb-1">Bases:</p>
                                  <div className="flex flex-wrap gap-1">
                                    {normalizedItem.bases.map((base, idx) => (
                                      <span key={idx} className="px-2 py-1 bg-amber-50 text-amber-700 text-xs rounded flex items-center">
                                        <FiCoffee className="w-3 h-3 mr-1" />
                                        {base}
                                      </span>
                                    ))}
                                  </div>
                                </div>
                              )}
                              
                              {normalizedItem.juiceUpsell && (
                                <div className="mt-3 p-2 bg-purple-50 rounded">
                                  <div className="flex items-center justify-between">
                                    <div>
                                      <p className="text-sm font-medium text-purple-700 mb-1">Juice Upsell:</p>
                                      <div className="flex items-center">
                                        {normalizedItem.juiceUpsell.size && (
                                          <span className="text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded mr-2">
                                            {normalizedItem.juiceUpsell.size}
                                          </span>
                                        )}
                                        <span className="text-sm">{normalizedItem.juiceUpsell.name}</span>
                                      </div>
                                    </div>
                                    <span className="text-sm font-medium text-purple-700">
                                      +{formatPrice(normalizedItem.juiceUpsell.price)} each
                                    </span>
                                  </div>
                                </div>
                              )}
                              
                              {normalizedItem.friesUpsell && (
                                <div className="mt-3 p-2 bg-orange-50 rounded">
                                  <div className="flex items-center justify-between">
                                    <div>
                                      <p className="text-sm font-medium text-orange-700 mb-1">Fries Upsell:</p>
                                      <div className="flex items-center">
                                        {normalizedItem.friesUpsell.size && (
                                          <span className="text-xs bg-orange-100 text-orange-800 px-2 py-1 rounded mr-2">
                                            {normalizedItem.friesUpsell.size}
                                          </span>
                                        )}
                                        <span className="text-sm">{normalizedItem.friesUpsell.name}</span>
                                      </div>
                                    </div>
                                    <span className="text-sm font-medium text-orange-700">
                                      +{formatPrice(normalizedItem.friesUpsell.price)} each
                                    </span>
                                  </div>
                                </div>
                              )}
                              
                              {cartItem.specialInstructions && (
                                <div className="mt-3 p-2 bg-gray-50 rounded">
                                  <p className="text-sm font-medium text-gray-700 mb-1">Special Instructions:</p>
                                  <p className="text-sm text-gray-600 italic">{cartItem.specialInstructions}</p>
                                </div>
                              )}
                            </div>
                            
                            {/* Price and Quantity Controls - Desktop */}
                            <div className="hidden md:flex flex-col items-end">
                              <div className="text-right mb-4">
                                <p className="text-2xl font-bold text-gray-900">
                                  {formatPrice(itemTotal)}
                                </p>
                                <p className="text-sm text-gray-500">
                                  {cartItem.quantity} × {formatPrice(cartItem.price)} base
                                </p>
                              </div>
                              
                              {/* Quantity Controls */}
                              <div className="flex items-center border rounded-lg">
                                <button
                                  onClick={() => handleQuantityChange(cartItem.id, -1)}
                                  disabled={cartItem.quantity <= 1}
                                  className="p-2 text-gray-600 hover:text-blue-600 disabled:opacity-50 disabled:cursor-not-allowed"
                                >
                                  <FiMinus className="w-5 h-5" />
                                </button>
                                <span className="px-4 py-2 font-medium min-w-[60px] text-center border-x">
                                  {cartItem.quantity}
                                </span>
                                <button
                                  onClick={() => handleQuantityChange(cartItem.id, 1)}
                                  className="p-2 text-gray-600 hover:text-blue-600"
                                >
                                  <FiPlus className="w-5 h-5" />
                                </button>
                              </div>
                              
                              <button
                                onClick={() => handleRemoveItem(cartItem.id)}
                                className="mt-3 flex items-center text-red-600 hover:text-red-800 text-sm"
                              >
                                <FiTrash2 className="mr-1 w-4 h-4" />
                                Remove
                              </button>
                            </div>
                          </div>
                          
                          {/* Mobile Quantity Controls */}
                          <div className="mt-4 md:hidden">
                            <div className="flex items-center justify-between">
                              <div className="flex items-center border rounded-lg">
                                <button
                                  onClick={() => handleQuantityChange(cartItem.id, -1)}
                                  disabled={cartItem.quantity <= 1}
                                  className="p-2 text-gray-600 hover:text-blue-600 disabled:opacity-50 disabled:cursor-not-allowed"
                                >
                                  <FiMinus className="w-5 h-5" />
                                </button>
                                <span className="px-4 py-2 font-medium min-w-[60px] text-center border-x">
                                  {cartItem.quantity}
                                </span>
                                <button
                                  onClick={() => handleQuantityChange(cartItem.id, 1)}
                                  className="p-2 text-gray-600 hover:text-blue-600"
                                >
                                  <FiPlus className="w-5 h-5" />
                                </button>
                              </div>
                              
                              <div className="text-right">
                                <p className="text-lg font-bold text-gray-900">
                                  {formatPrice(itemTotal)}
                                </p>
                                <button
                                  onClick={() => handleRemoveItem(cartItem.id)}
                                  className="mt-1 flex items-center text-red-600 hover:text-red-800 text-sm"
                                >
                                  <FiTrash2 className="mr-1 w-4 h-4" />
                                  Remove
                                </button>
                              </div>
                            </div>
                          </div>
                          
                          {/* Price Breakdown - Always show for complex items, or on edit */}
                          {(editingItem === cartItem.id || 
                            normalizedItem.addons?.length > 0 || 
                            normalizedItem.juiceUpsell || 
                            normalizedItem.friesUpsell) && (
                            <div className="mt-4 p-3 bg-gray-50 rounded-lg">
                              <p className="text-sm font-medium text-gray-700 mb-2">Price Breakdown:</p>
                              <div className="space-y-1 text-sm">
                                <div className="flex justify-between">
                                  <span className="text-gray-600">Base price ({cartItem.quantity} × {formatPrice(cartItem.price)}):</span>
                                  <span className="font-medium">{formatPrice(priceBreakdown.basePrice)}</span>
                                </div>
                                
                                {priceBreakdown.addonsTotal > 0 && (
                                  <div className="flex justify-between">
                                    <span className="text-gray-600">Add-ons total:</span>
                                    <span className="font-medium text-blue-600">+{formatPrice(priceBreakdown.addonsTotal)}</span>
                                  </div>
                                )}
                                
                                {priceBreakdown.juiceUpsellPrice > 0 && (
                                  <div className="flex justify-between">
                                    <span className="text-gray-600">Juice upsell:</span>
                                    <span className="font-medium text-purple-600">+{formatPrice(priceBreakdown.juiceUpsellPrice)}</span>
                                  </div>
                                )}
                                
                                {priceBreakdown.friesUpsellPrice > 0 && (
                                  <div className="flex justify-between">
                                    <span className="text-gray-600">Fries upsell:</span>
                                    <span className="font-medium text-orange-600">+{formatPrice(priceBreakdown.friesUpsellPrice)}</span>
                                  </div>
                                )}
                                
                                <div className="border-t pt-1 mt-1">
                                  <div className="flex justify-between font-medium">
                                    <span>Item total:</span>
                                    <span>{formatPrice(priceBreakdown.itemTotal)}</span>
                                  </div>
                                </div>
                              </div>
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
              
              {/* Cart Actions */}
              <div className="p-6 border-t bg-gray-50">
                <div className="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
                  <button
                    onClick={clearCart}
                    className="flex items-center text-red-600 hover:text-red-800 font-medium"
                  >
                    <FiTrash2 className="mr-2" />
                    Clear Entire Cart
                  </button>
                  
                  <Link
                    href="/menu"
                    className="flex items-center text-blue-600 hover:text-blue-800 font-medium"
                  >
                    <FiArrowLeft className="mr-2" />
                    Continue Shopping
                  </Link>
                </div>
              </div>
            </div>
            
            {/* Trust Badges */}
            <div className="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
              <div className="bg-white p-4 rounded-lg shadow text-center">
                <div className="text-2xl mb-2">🚚</div>
                <p className="font-medium text-sm">Free Delivery</p>
                <p className="text-xs text-gray-600">Over R850</p>
              </div>
              <div className="bg-white p-4 rounded-lg shadow text-center">
                <div className="text-2xl mb-2">🛡️</div>
                <p className="font-medium text-sm">Quality Guaranteed</p>
                <p className="text-xs text-gray-600">100% Organic</p>
              </div>
              <div className="bg-white p-4 rounded-lg shadow text-center">
                <div className="text-2xl mb-2">🔒</div>
                <p className="font-medium text-sm">Secure Payment</p>
                <p className="text-xs text-gray-600">Encrypted & Safe</p>
              </div>
              <div className="bg-white p-4 rounded-lg shadow text-center">
                <div className="text-2xl mb-2">⭐</div>
                <p className="font-medium text-sm">5-Star Rated</p>
                <p className="text-xs text-gray-600">By Customers</p>
              </div>
            </div>
          </div>

          {/* Order Summary Sidebar */}
          <div className="lg:col-span-1">
            <div className="bg-white rounded-xl shadow-lg p-6 sticky top-8">
              <h2 className="text-xl font-bold text-gray-900 mb-6">Order Total</h2>
              
              {/* Price Breakdown */}
              <div className="space-y-4 mb-6">
                <div className="flex justify-between">
                  <span className="text-gray-600">Subtotal ({totalItems} items)</span>
                  <span className="font-medium">{formatPrice(totalPrice)}</span>
                </div>
                
                {/* Show breakdown of what's included in subtotal */}
                <div className="text-xs text-gray-500">
                  <p>Includes:</p>
                  <ul className="list-disc list-inside ml-2 mt-1 space-y-1">
                    <li>Base menu items</li>
                    <li>All add-ons and customizations</li>
                    <li>Upsell items (juices, fries)</li>
                  </ul>
                </div>
                
                <div className="flex justify-between">
                  <span className="text-gray-600">Delivery Fee</span>
                  <span className={`font-medium ${deliveryInfo.freeDelivery ? 'text-green-600' : ''}`}>
                    {deliveryInfo.freeDelivery ? 'FREE' : formatPrice(deliveryInfo.deliveryFee)}
                  </span>
                </div>
                
                {!deliveryInfo.freeDelivery && (
                  <div className="p-3 bg-blue-50 rounded-lg">
                    <p className="text-sm text-blue-800 text-center">
                      Add <span className="font-bold">{formatPrice(850 - totalPrice)}</span> more for free delivery!
                    </p>
                  </div>
                )}
                
                <div className="border-t pt-4">
                  <div className="flex justify-between text-lg font-bold">
                    <span className="text-gray-900">Total</span>
                    <span className="text-gray-900">
                      {formatPrice(totalPrice + (deliveryInfo.freeDelivery ? 0 : deliveryInfo.deliveryFee))}
                    </span>
                  </div>
                  <p className="text-sm text-gray-500 mt-1 text-right">
                    Includes VAT where applicable
                  </p>
                </div>
              </div>

              {/* Authentication Status */}
              {!user ? (
                <div className="mb-6">
                  <div className="p-4 bg-yellow-50 border border-yellow-200 rounded-lg mb-4">
                    <div className="flex items-center mb-2">
                      <FiLock className="text-yellow-600 mr-2" />
                      <span className="font-medium text-yellow-800">Guest Checkout</span>
                    </div>
                    <p className="text-sm text-yellow-700 mb-4">
                      Create an account for faster checkout and order tracking.
                    </p>
                    <button
                      onClick={handleCheckout}
                      className="w-full py-3 bg-green-600 text-white font-bold rounded-lg hover:bg-green-700 transition mb-3"
                    >
                      Continue as Guest
                    </button>
                    <div className="space-y-2">
                      <button
                        onClick={() => router.push("/auth/signup?returnUrl=/checkout")}
                        className="w-full py-2 border border-blue-600 text-blue-600 text-center rounded-lg hover:bg-blue-50 transition"
                      >
                        Create Account
                      </button>
                      <button
                        onClick={() => router.push("/auth/signin?returnUrl=/checkout")}
                        className="w-full py-2 text-gray-600 text-center rounded-lg hover:bg-gray-100 transition"
                      >
                        Sign In
                      </button>
                    </div>
                  </div>
                </div>
              ) : (
                <button
                  onClick={handleCheckout}
                  className="w-full py-4 bg-green-600 text-white font-bold rounded-lg hover:bg-green-700 transition mb-6 shadow-lg"
                >
                  Proceed to Secure Checkout
                </button>
              )}
              
              {/* Continue Shopping Button */}
              <Link
                href="/menu"
                className="inline-flex items-center justify-center w-full py-3 border-2 border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition mb-6"
              >
                <FiArrowLeft className="mr-2" />
                Browse More From Menu
              </Link>

              {/* Delivery Estimate */}
              <div className="p-4 bg-gray-50 rounded-lg">
                <div className="flex items-center mb-2">
                  <FiTruck className="w-5 h-5 text-gray-600 mr-2" />
                  <span className="font-medium text-gray-800">Delivery Estimate</span>
                </div>
                <p className="text-sm text-gray-600">
                  Orders placed before 2 PM are delivered same day. Delivery times: 9 AM - 6 PM.
                </p>
              </div>
              
              {/* Price Transparency Note */}
              <div className="mt-4 p-3 bg-green-50 border border-green-200 rounded-lg">
                <div className="flex items-center mb-1">
                  <FiDollarSign className="w-4 h-4 text-green-600 mr-2" />
                  <span className="text-sm font-medium text-green-800">Price Transparency</span>
                </div>
                <p className="text-xs text-green-700">
                  All prices for add-ons, upsells, and customizations are clearly displayed and included in your total.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
