// Add this to your cart page to debug address selection
// Look for the handleAddressSelect function and add console logs

// Example of what to add:
const handleAddressSelect = (address: any) => {
  console.log("=== ADDRESS SELECTED ===");
  console.log("Full address object:", address);
  console.log("Coordinates:", address.coordinates);
  console.log("Formatted address:", address.formattedAddress);
  
  // Validate coordinates are in Cape Town
  if (address.coordinates.lat < -34.5 || address.coordinates.lat > -33.5 ||
      address.coordinates.lng < 18.0 || address.coordinates.lng > 19.0) {
    console.error("WARNING: Coordinates outside Cape Town area!");
    console.error("Expected: lat between -34.5 and -33.5, lng between 18.0 and 19.0");
    console.error("Got:", address.coordinates);
  }
  
  // Your existing code continues...
};
